# MongoDB connection string
# Local example: mongodb://127.0.0.1:27017/hostelfix
# Atlas example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/hostelfix
MONGO_URI=

# Secret used to sign JWTs - use a long random string, never commit the real value
JWT_SECRET=

# How long a login token stays valid, e.g. 7d, 12h, 30m
JWT_EXPIRES_IN=7d

# Port the Express server listens on
PORT=5000

# URL of the frontend, used for CORS
CLIENT_URL=http://localhost:5173
